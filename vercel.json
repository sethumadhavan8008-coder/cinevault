{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/backend/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}